# Copy to terraform.tfvars (gitignored) and fill in. Never commit the real file.

sql_admin_group = {
  login     = "you@example.com"                      # your Entra sign-in name, or a group name
  object_id = "00000000-0000-0000-0000-000000000000" # az ad signed-in-user show --query id -o tsv
}

budget_amount         = 10
budget_start_date     = "2026-11-01T00:00:00Z"
budget_contact_emails = ["you@example.com"]

# From infra/identity: terraform output tenant_id / api_client_id
entra_tenant_id = "00000000-0000-0000-0000-000000000000"
api_audience    = "00000000-0000-0000-0000-000000000000"

# terraform output -json group_object_ids in infra/identity
group_object_ids = {
  readers        = "00000000-0000-0000-0000-000000000000"
  contributors   = "00000000-0000-0000-0000-000000000000"
  reviewers      = "00000000-0000-0000-0000-000000000000"
  administrators = "00000000-0000-0000-0000-000000000000"
  finance        = "00000000-0000-0000-0000-000000000000"
  hr             = "00000000-0000-0000-0000-000000000000"
}
